{
  "$comment": "PROJECT SETTINGS for ai-os (Node). Committed deliberately: this file documents how the repo is worked on. Machine-wide guardrails live in ~/.claude/settings.json and always win — deny beats allow at every level, so nothing here can re-open them.",
  "mcpServers": {
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    }
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "mcp__firecrawl__*",
      "Bash(node tools/test-all.js)",
      "Bash(node tools/test-all.js *)",
      "Bash(node tools/seclint.js --ci)",
      "Bash(node tools/seclint.js --ci *)",
      "Bash(node tools/test-handbooks.js)",
      "Bash(node tools/test-handbooks.js *)",
      "Bash(node tools/check-copy-drift.js)",
      "Bash(node tools/check-copy-drift.js *)",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__Claude_Preview__preview_logs",
      "mcp__Claude_Preview__preview_snapshot",
      "mcp__Claude_Preview__preview_console_logs",
      "mcp__Claude_Browser__preview_logs",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__tabs_context",
      "mcp__ccd_session_mgmt__list_sessions",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git commit -m:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(docker build:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Read(docs/**)",
      "Read(README.md)",
      "Edit(docs/**)",
      "Bash(node_modules/.bin/fallow:*)",
      "Bash(./node_modules/.bin/fallow:*)",
      "Bash(fallow:*)",
      "Bash(node tools/check-deps-installed.js:*)",
      "Bash(node tools/check-nginx-headers.js:*)",
      "Bash(node --check:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:sec:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh repo view:*)",
      "Read(lib/**)",
      "Read(tools/**)",
      "Read(dashboard/**)",
      "Read(deploy/**)",
      "Read(.claude/agents/**)",
      "Edit(lib/**)",
      "Edit(tools/**)",
      "Edit(dashboard/**)"
    ],
    "ask": [
      "Bash(nmap:*)",
      "Bash(sqlmap:*)",
      "Bash(nikto:*)",
      "Edit(pyproject.toml)",
      "Edit(Dockerfile)",
      "Edit(docker-compose*.yml)",
      "Edit(.github/workflows/**)"
    ],
    "deny": [
      "Read(deploy/**/*.env*)",
      "Read(infra/secrets/**)",
      "Read(**/n8n/**)",
      "Read(**/*.sqlite)",
      "Read(**/*.db)",
      "Edit(.github/workflows/release*.yml)",
      "Bash(git commit --no-verify:*)",
      "Bash(pytest --no-cov -k:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/seclint.js --hook"
          }
        ]
      }
    ]
  }
}
