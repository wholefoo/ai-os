{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "server.js",
    "agent-worker/agent.js",
    "tools/generate-maps.js",
    "tools/test-analytics.js",
    "tools/test-okf.js",
    "tools/test-leads.js",
    "tools/test-sections.js",
    "tools/test-funnel-dynamic.js",
    "ecosystem.config.js",
    "deploy/n8n-ecosystem.config.example.js",
    "dashboard/js/*.js"
  ],
  "ignorePatterns": [
    "docs-export/**",
    "node_modules/**",
    "dashboard/css/**",
    "auto-research/**"
  ],
  "ignoreUnresolvedImports": [
    "/css/**",
    "/js/**",
    "./commercial/loader",
    "./commercial/**"
  ],
  "ignoreExports": [
    { "file": "lib/orchestrator.js", "exports": ["classifyAndAct", "fanOutAndSynthesize", "adversarialVerify", "generateAndFilter", "tournament", "loopUntilDone"] },
    { "file": "lib/multiModel.js", "exports": ["scoreConsensus", "extractScore"] },
    { "file": "lib/security/mythos.js", "exports": ["assess", "audit", "resolveSafeWorkspace", "threatModel"] },

    { "file": "lib/crm/repo.js", "exports": ["normEmail"] },
    { "file": "lib/crm/sync.js", "exports": ["syncFromAudits", "syncFromLeads", "syncFromSites", "syncFromUsers", "backfillAll"] },
    { "file": "lib/crm/db.js", "exports": ["openDb"] },
    { "file": "lib/crm/routes.js", "exports": ["registerCrmRoutes"] },
    { "file": "lib/crm/index.js", "exports": ["backfillAll", "openDb", "registerCrmRoutes"] },

    { "file": "lib/web-studio/build.js", "exports": ["MAX_CONCURRENT"] },
    { "file": "lib/web-studio/dns.js", "exports": ["getPublicIps"] },
    { "file": "lib/web-studio/hosting.js", "exports": ["DOMAIN_RE", "attachDomainWithTls"] },
    { "file": "lib/web-studio/import.js", "exports": ["MAX_FILES", "MAX_TOTAL_BYTES", "SAFE_EXT", "cloneGitHub", "extractZip", "findStaticRoot", "ingestDir", "sanitizeRelPath"] },
    { "file": "lib/web-studio/pipeline.js", "exports": ["extractJson", "renderBase", "renderPage", "renderSection", "buildSiteKnowledge"] },
    { "file": "lib/web-studio/publish.js", "exports": ["KEEP_RELEASES", "pruneReleases", "rollback"] },
    { "file": "lib/web-studio/scaffold.js", "exports": ["tokensCss"] },
    { "file": "lib/self-improve/plan-store.js", "exports": ["DENIED_PATH_PREFIXES", "isPathAllowed"] }
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {}
}
