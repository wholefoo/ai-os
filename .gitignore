# Dependencies
node_modules/

# Commercial/enterprise modules live in a SEPARATE PRIVATE repo (ai-os-commercial), cloned into
# ./commercial/ on licensed/operator deployments. NEVER commit them to this public repo — the open
# core falls back to lib/commercial-stub.js (Community tier) when this directory is absent.
/commercial/

# Environment
.env
.env.local
.env.production

# Agent memory & artifacts
.magent/artifacts/
.magent/runs/
.magent/vault/raw/
.magent/state/

# CRM embedded database (runtime data + WAL sidecars) — never commit
.magent/crm.sqlite
.magent/crm.sqlite-wal
.magent/crm.sqlite-shm
.magent/analytics.sqlite
.magent/analytics.sqlite-wal
.magent/analytics.sqlite-shm

# Content-provenance Ed25519 signing key — a leak forges every provenance record; never commit
.magent/provenance/
# Business documents an owner uploaded — the company's own material, never ours to commit
.magent/org-docs/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build output
dist/
build/

# Exported docs (private reference). The generated .docx, the local package.json and the local
# node_modules stay out — but the GENERATOR is source, and an untracked source file is invisible to
# every guard in tools/. That is not theoretical: a repo-wide sweep for `sudo -u … pm2` fixed 17
# lines and silently missed the two in this generator, which feed a customer-facing document.
#
# `docs-export/*`, not `docs-export/` — git cannot re-include a file whose parent DIRECTORY is
# excluded, so the negation below only works if the directory itself is never excluded.
docs-export/*
!docs-export/generate-stripe-guide.js

# Tenant data
.magent/tenants/

# VPS self-improvement proposal staging + ingest ledger (maintainer-local)
.magent/vps-proposals/

# Temp files
*.tmp
*.bak
.fallow/

# Auto Research loop runtime data
auto-research/history/
auto-research/asset/*
!auto-research/asset/.gitkeep

# Carousel source art (optimized .webp is committed instead)
dashboard/assets/carousel/*.png

# Real generated Omni media (Veo video, Gemini image, Gemini TTS audio) — runtime output, never commit
data/media-videos/
data/media-images/
data/media-audio/

# Scheduled intel-brief output — generated daily, like the media dirs above
data/intel-briefs/

# scratch: run ids written by tools/dispatch helpers
.last-run-id
.sweep-*-runid
