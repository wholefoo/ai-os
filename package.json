{
  "name": "ai-os-orchestration-lab",
  "version": "1.0.0",
  "description": "Multi-Agentic Workflow AI Operating System with Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "prod": "NODE_ENV=production node server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ai-os",
    "pm2:restart": "pm2 restart ai-os",
    "pm2:logs": "pm2 logs ai-os",
    "docker:build": "docker build -t ai-os .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "maps": "node tools/generate-maps.js",
    "lint:dead": "fallow dead-code",
    "lint:dupes": "fallow dupes",
    "lint:sec": "node tools/seclint.js --ci",
    "test": "node tools/test-all.js && fallow dead-code && fallow dupes && node tools/seclint.js --ci",
    "audit": "npm audit"
  },
  "dependencies": {
    "adm-zip": "0.6.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "9.7.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "js-yaml": "^4.2.0",
    "morgan": "^1.10.1",
    "node-cron": "^4.6.0",
    "nodemailer": "9.0.5",
    "stripe": "^22.4.0",
    "unpdf": "^1.8.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "fallow": "2.91.0"
  }
}
