PORT=3000
NODE_ENV=development
DEMO_MODE=true

# Auth — set a strong random token to protect all API endpoints
# Leave blank to disable auth (dev mode only)
API_TOKEN=

# Admin account — seeded on first run
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=$2b$12$...

# CORS — allowed origin for production (e.g., https://yourdomain.com)
CORS_ORIGIN=*

# Commercial License — set both to unlock Business/Enterprise features
# AIOS_SIGNING_SECRET is your private secret for generating and validating license keys
# AIOS_LICENSE_KEY is the key itself (format: AIOS-{TIER}-{TIMESTAMP}-{RANDOM}-{CHECKSUM})
# Generate a key: node -e "process.env.AIOS_SIGNING_SECRET='your-secret'; console.log(require('./commercial/lib/license-validator').generateLicenseKey('BIZ'))"
AIOS_SIGNING_SECRET=
AIOS_LICENSE_KEY=
# Or place key in .magent/license.key file
# (AIOS_LICENSE_STRICT is gone: 16-bit legacy signatures are now always rejected, so there is
#  nothing left to toggle. A key must carry the 64-bit signature generateLicenseKey emits.)

# Content provenance — an Ed25519 key signs the provenance sidecars that generated sites carry.
# Optional: auto-generated under .magent/provenance/ on first boot if unset. Set it for prod /
# multi-instance so every instance signs with the same key. Generate (PKCS8 PEM):
#   node -e "console.log(require('crypto').generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'pem'}}).privateKey)"
AIOS_PROVENANCE_PRIVATE_KEY=
# Control-plane public URL — makes a sidecar's key id resolve to /.well-known/provenance-keys.json
AIOS_PUBLIC_URL=

# Stripe — one-time license payments
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BUSINESS_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...
STRIPE_ENTERPRISE_UPGRADE_PRICE_ID=price_...   # Business→Enterprise upgrade ($3,000 one-time)

# API Keys — AI Models
ANTHROPIC_API_KEY=your-key-here
OPENAI_API_KEY=your-openai-key-here
GEMINI_API_KEY=your-gemini-api-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here
# Z.ai (Zhipu GLM, e.g. GLM-5.2) — OpenAI-compatible; joins the multi-model consensus
ZAI_API_KEY=your-zai-glm-key-here
XAI_API_KEY=your-xai-grok-key-here
PERPLEXITY_API_KEY=your-perplexity-key-here

# API Keys — Autonomous Agents
MANUS_API_KEY=your-manus-key-here

# Avatar Voice Pipeline (LiveKit + Deepgram + Cartesia)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud
DEEPGRAM_API_KEY=your-deepgram-key
CARTESIA_API_KEY=your-cartesia-key

# Avatar Video — talking-head providers (optional; used by the interactive avatar UI)
HEYGEN_API_KEY=your-heygen-key-here
DID_API_KEY=your-d-id-key-here

# API Keys — Web Tools
FIRECRAWL_API_KEY=your-firecrawl-key-here
TAVILY_API_KEY=your-tavily-key-here
APIFY_API_TOKEN=your-apify-token-here

# YouTube Intelligence — yt-dlp handles video/frames; API key is for YouTube Data API metadata (optional)
YOUTUBE_API_KEY=your-youtube-data-api-key-here

# SEO Agency — DataForSEO
DATAFORSEO_LOGIN=your-dataforseo-email
DATAFORSEO_PASSWORD=your-dataforseo-password

# Notifications — leave EMPTY unless you actually use the channel.
# These were `your-...-here` placeholders, which are truthy: copying this file to .env made the
# platform believe Slack was configured, so every notification fired a real request at a string
# that was never a URL and failed. Empty means "not configured", which is silent and correct.
# Slack: create an Incoming Webhook at https://api.slack.com/messaging/webhooks (https URL).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=

# Hermes Agent — Persistent background worker via MCP
HERMES_MCP_URL=http://127.0.0.1:8420

# Automation
N8N_WEBHOOK_BASE=http://localhost:5678
N8N_API_KEY=your-n8n-api-key-here
TEAM_WEBHOOK_URL=your-team-webhook-url-here
