{
  "env": {
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1"
  },
  "permissions": {
    "allow": ["Bash"],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(git push *)",
      "Read(~/.config/hermes-runner/**)",
      "Read(~/.ssh/**)",
      "Read(~/work/**)",
      "Read(**/.env)",
      "Edit(~/.config/**)",
      "Edit(~/.ssh/**)",
      "Edit(~/work/**)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)",
      "Edit(~/.claude/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["/home/hermes-agent"],
      "denyRead": ["/home/hermes/.config", "/home/hermes/.ssh", "/home/hermes/work", "/home/hermes/.bash_history"]
    },
    "credentials": {
      "files": [
        { "path": "~/.config/hermes-runner", "mode": "deny" },
        { "path": "~/.ssh", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org"],
      "strictAllowlist": true
    }
  }
}
